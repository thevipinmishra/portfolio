const { n } = Astro.props;
const v = SCREWS[n];
if (!v) throw new Error(`Unknown frame joint ${n}`);

const id = `sj${n}`;

function diskPath(cx: number, cy: number, rx: number, ry: number, dents: number[]) {
	const count = dents.length;
	const k = (4 / 3) * Math.tan(Math.PI / (2 * count));
	const pts = dents.map((dent, i) => {
		const a = (i / count) * Math.PI * 2 - Math.PI / 2;
		const x = cx + Math.cos(a) * rx * dent;
		const y = cy + Math.sin(a) * ry * dent;
		const tx = -Math.sin(a);
		const ty = Math.cos(a);
		const tr = ((rx + ry) / 2) * dent * k;
		return { x, y, ix: x - tx * tr, iy: y - ty * tr, ox: x + tx * tr, oy: y + ty * tr };
	});
	let d = `M${pts[0].x.toFixed(2)},${pts[0].y.toFixed(2)}`;
	for (let i = 0; i < count; i++) {
		const p = pts[i];
		const q = pts[(i + 1) % count];
		d += `C${p.ox.toFixed(2)},${p.oy.toFixed(2)} ${q.ix.toFixed(2)},${q.iy.toFixed(2)} ${q.x.toFixed(2)},${q.y.toFixed(2)}`;
	}
	return `${d}Z`;
}

function groove(
	cx: number,
	cy: number,
	length: number,
	height: number,
	rl: number,
	rr: number,
	tt: number,
	tb: number,
) {
	const x = cx - length / 2;
	const y = cy - height / 2;
	const xL = x;
	const xR = x + length;
	const yTL = y + tt;
	const yTR = y - tt;
	const yBL = y + height + tb;
	const yBR = y + height - tb;
	const ryL = Math.max(0.35, Math.abs(yBL - yTL) / 2);
	const ryR = Math.max(0.35, Math.abs(yBR - yTR) / 2);
	return `M${(xL + rl).toFixed(2)},${yTL.toFixed(2)}L${(xR - rr).toFixed(2)},${yTR.toFixed(2)}A${rr.toFixed(2)},${ryR.toFixed(2)} 0 0 1 ${(xR - rr).toFixed(2)},${yBR.toFixed(2)}L${(xL + rl).toFixed(2)},${yBL.toFixed(2)}A${rl.toFixed(2)},${ryL.toFixed(2)} 0 0 1 ${(xL + rl).toFixed(2)},${yTL.toFixed(2)}Z`;
}

const headScale = 0.82;
const headRx = v.rx * headScale;
const headRy = v.ry * headScale;
const plateCx = 16 + (v.cx - 16) * 0.22;
const plateCy = 16.3 + (v.cy - 16) * 0.18;
const plateDents = v.dents.map((d) => 1 + (d - 1) * 0.3);
const plate = diskPath(plateCx, plateCy, 15.65, 15.2, plateDents);
const plateBevel = diskPath(plateCx, plateCy, 14.35, 13.95, plateDents);
const crevice = diskPath(v.cx, v.cy, headRx + 0.95, headRy + 0.9, v.dents);
const head = diskPath(v.cx, v.cy, headRx, headRy, v.dents);
const specCx = v.cx + (v.spec.cx - v.cx) * headScale;
const specCy = v.cy + (v.spec.cy - v.cy) * headScale;
const slotCx = v.cx + v.slot.ox * headScale;
const slotCy = v.cy + v.slot.oy * headScale;
const slotLen = Math.min(v.slot.len * headScale, headRx + headRy - 3.4);
const slotH = v.slot.h * 0.92;
const chamfer = groove(
	slotCx,
	slotCy,
	slotLen,
	slotH,
	v.slot.rl,
	v.slot.rr,
	v.slot.tt,
	v.slot.tb,
);
const floor = groove(
	slotCx,
	slotCy + 0.16,
	slotLen - 0.85,
	Math.max(0.9, slotH - 0.85),
	Math.max(0.3, v.slot.rl - 0.22),
	Math.max(0.3, v.slot.rr - 0.22),
	v.slot.tt * 0.35,
	v.slot.tb * 0.35,
);
const lipY = slotCy - slotH / 2 + v.slot.tt + 0.28;
const lipX1 = slotCx - slotLen / 2 + v.slot.rl + 0.35;
const lipX2 = slotCx + slotLen / 2 - v.slot.rr - 0.35;
---

<span
	class="frame-joint"
	style={`--screw-nudge-x:${v.nx}px;--screw-nudge-y:${v.ny}px;--screw-scale-x:${v.sx};--screw-scale-y:${v.sy}`}
>
	<svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
		<defs>
			<linearGradient id={`${id}-p`} x1="18%" y1="6%" x2="84%" y2="94%">
				<stop
					offset="0%"
					stop-color="color-mix(in oklab, var(--color-screw-washer) 62%, var(--color-screw-hi))"
				></stop>
				<stop offset="48%" stop-color="var(--color-screw-washer)"></stop>
				<stop
					offset="100%"
					stop-color="color-mix(in oklab, var(--color-screw-washer) 68%, var(--color-screw-lo))"
				></stop>
			</linearGradient>
			<radialGradient id={`${id}-h`} cx={`${34 + (n % 5)}%`} cy={`${26 + (n % 4)}%`} r="72%">
				<stop
					offset="0%"
					stop-color="color-mix(in oklab, var(--color-screw-hi) 70%, var(--color-screw-mid))"
				></stop>
				<stop offset="38%" stop-color="var(--color-screw-mid)"></stop>
				<stop offset="100%" stop-color="var(--color-screw-lo)"></stop>
			</radialGradient>
			<clipPath id={`${id}-c`}>
				<path d={head}></path>
			</clipPath>
		</defs>

		<path
			d={plate}
			fill={`url(#${id}-p)`}
			stroke="color-mix(in oklab, var(--color-screw-lo) 58%, #000)"
			stroke-width="0.55"
			stroke-linejoin="round"
		></path>
		<path
			d={plateBevel}
			fill="none"
			stroke="var(--color-screw-hi)"
			stroke-width="0.45"
			opacity="0.28"
		></path>
		<path
			d={crevice}
			fill="none"
			stroke="color-mix(in oklab, var(--color-screw-lo) 50%, #000)"
			stroke-width="1.05"
			opacity="0.4"
		></path>
		<path
			d={head}
			fill={`url(#${id}-h)`}
			stroke="color-mix(in oklab, var(--color-screw-lo) 55%, #000)"
			stroke-width="0.65"
			stroke-linejoin="round"
		></path>

		<g clip-path={`url(#${id}-c)`}>
			<ellipse
				cx={v.cx}
				cy={v.cy + headRy * 0.46}
				rx={headRx * 0.88}
				ry={headRy * 0.46}
				fill="#000"
				opacity="0.12"
			></ellipse>
			<ellipse
				cx={specCx}
				cy={specCy}
				rx={v.spec.rx * headScale}
				ry={v.spec.ry * headScale}
				transform={`rotate(${v.spec.rot} ${specCx} ${specCy})`}
				fill="var(--color-screw-hi)"
				opacity="0.62"
			></ellipse>
		</g>

		<g transform={`rotate(${v.turn} ${v.cx} ${v.cy})`}>
			<path d={chamfer} fill="var(--color-screw-slot)"></path>
			<path d={floor} fill="color-mix(in oklab, var(--color-screw-slot) 70%, #000)"></path>
			<line
				x1={lipX1}
				y1={lipY}
				x2={lipX2}
				y2={lipY - v.slot.tt}
				stroke="var(--color-screw-hi)"
				stroke-width="0.42"
				stroke-linecap="round"
				opacity="0.4"
			></line>
		</g>
	</svg>
</span>
