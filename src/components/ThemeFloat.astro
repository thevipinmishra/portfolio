---
import ThemeToggle from './ThemeToggle.svelte';
---

<div class="theme-float">
	<ThemeToggle client:load />
</div>

<style>
	.theme-float {
		--theme-end: max(1rem, env(safe-area-inset-right));
		position: fixed;
		top: max(1rem, env(safe-area-inset-top));
		inset-inline-end: var(--theme-end);
		z-index: 40;
	}

	@media (max-width: 72rem) {
		.theme-float {
			--theme-end: max(
				calc(var(--space-page) + 0.75rem),
				env(safe-area-inset-right)
			);
		}
	}
</style>
